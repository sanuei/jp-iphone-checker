{
  "version": 2,
  "builds": [
    {
      "src": "dist/api/check.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/check",
      "dest": "/dist/api/check.js"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "installCommand": "npm install",
  "buildCommand": "./node_modules/typescript/bin/tsc"
}